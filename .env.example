# Names and local examples only. Never commit .env.
# Provision supplies DATABASE_URL/PG*, MCP validation and the platform theme on the box.
PORT=8080
# Set DATABASE_URL to a development database you may use; never copy a production secret here.
DATABASE_URL=
# Local only: platform provisioning never copies LOCAL_* keys to a deployed app.
LOCAL_AUTH_MOCK_EMAIL=dev@example.com
LOCAL_AUTH_MOCK_NAME="Local Dev"
# Local only: groups of the mock person, | separated (e.g. ihc-admins to try the approver view).
LOCAL_AUTH_MOCK_GROUPS=
# Server-side company theme URL. Empty/unavailable uses the bundled neutral theme.
IHC_THEME_URL=
# Company sign-in groups whose members approve expenses (| separated).
# Default when unset: ihc-admins|reembolso-gestores
APPROVER_GROUPS=
# For a local gateway integration, set IHC_MCP_ISSUER, IHC_MCP_JWKS_URL, IHC_MCP_AUDIENCE.
